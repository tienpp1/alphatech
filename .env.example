# ==============================================================================
# AI Business Operations Platform - Environment Configuration Template
# ==============================================================================

# Django Core
DEBUG=False
SECRET_KEY=django-insecure-change-me-in-production-ai-business-platform-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL + PostGIS)
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=ai_business_platform_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Application Defaults
DEFAULT_PAGE_SIZE=20
WORKSPACE_DEFAULT=retail

# Google Identity Services / OAuth 2.0
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-rotated-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/accounts/google/callback/
GOOGLE_OAUTH_USE_ENV_PROXY=False
PUBLIC_BASE_URL=http://localhost:8000

# Security headers (report-only is the safe local/staging default; enforce after review)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
CSP_REPORT_ONLY=True
CSP_ENFORCE=False

# Production observability (optional until staging is provisioned)
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=ai-business-platform

# Production must use HTTPS, secure cookies and an explicit public URL:
# DEBUG=False
# PUBLIC_BASE_URL=https://your-domain.example
# GOOGLE_REDIRECT_URI=https://your-domain.example/accounts/google/callback/
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True

# Real Customer Email Notifications via Gmail SMTP
# (Cấu hình Gmail gửi thư tự động đến hòm thư thực tế của khách hàng)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_company_email@gmail.com
# EMAIL_HOST_PASSWORD=your_16_char_app_password
# DEFAULT_FROM_EMAIL=your_company_email@gmail.com

# AI & LLM Configuration (Phase 8+)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70
